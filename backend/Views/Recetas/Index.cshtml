@model IEnumerable<backend.Models.Receta>

@{
    ViewData["Title"] = "Recetas";
}



<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Recetas</h2>

        <a asp-action="Crear" asp-controller="Recetas"
           class="btn boton-marron">
           <i class="fa-solid fa-plus"></i> Crear
        </a>
    </div>

<div class="row g-4">

    @foreach (var receta in Model)
    {
        <div class="col-md-4">

            <div class="card h-100 shadow-sm" style="border: 1px solid #54494B; overflow: hidden;">

                <img src="@receta.FotoPrincipal" class="card-img-top" alt="@receta.Titulo"
                     style="height: 220px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        @receta.Titulo
                    </h5>

                    <p class="card-text">
                        @receta.Descripcion
                    </p>

                    <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@receta.ID"
                       class="btn boton-marron mt-auto">
                        Ver Detalles
                    </a>

                </div>
            </div>

        </div>
    }

</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        Todavía no hay recetas publicadas.
    </div>
}

</div>