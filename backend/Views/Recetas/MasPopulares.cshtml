@model IEnumerable<backend.Models.Receta>

@{
    ViewData["Title"] = "Recetas Populares";
    int paginaActual = (int)(ViewBag.PaginaActual ?? 1);
    int totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
}

<div class="container py-5">

    <h1 class="text-center fw-bold color-marron">
        RECETAS POPULARES
    </h1>
    <hr>

    <p class="text-center text-muted">
        Descubrí los sabores favoritos de la comunidad
    </p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">

        @foreach (var receta in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (receta.FotoDatos != null)
                    {
                        <img src="/Imagenes/Receta/@receta.ID" class="card-img-top" alt="@receta.Titulo"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else if (!string.IsNullOrEmpty(receta.FotoPrincipal))
                    {
                        <img src="@receta.FotoPrincipal" class="card-img-top" alt="@receta.Titulo"
                             style="height: 200px; object-fit: cover;" />
                    }

                    <div class="card-body text-center">
                        <h5 class="card-title fw-semibold mb-1">
                            <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@receta.ID"
                               class="text-decoration-none text-dark stretched-link">@receta.Titulo</a>
                        </h5>
                    </div>
                </div>
            </div>
        }

    </div>

    @if (totalPaginas > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="MasPopulares" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@paginaActual de @totalPaginas</span>
                </li>
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="MasPopulares" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }

</div>