@model IEnumerable<backend.Models.Receta>

@{
    ViewData["Title"] = "Recetas Populares";
    int paginaActual = ViewBag.PaginaActual ?? 1;
}

<div class="container py-5">

    <h1 class="text-center fw-bold color-marron">
        RECETAS POPULARES
    </h1>
    <hr>

    <p class="text-center text-muted">
        Descubrí los sabores favoritos de la comunidad
    </p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">

        @foreach (var receta in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (receta.FotoDatos != null)
                    {
                        <img src="/Imagenes/Receta/@receta.ID" class="card-img-top" alt="@receta.Titulo"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else if (!string.IsNullOrEmpty(receta.FotoPrincipal))
                    {
                        <img src="@receta.FotoPrincipal" class="card-img-top" alt="@receta.Titulo"
                             style="height: 200px; object-fit: cover;" />
                    }

                    <div class="card-body text-center">
                        <h5 class="card-title fw-semibold mb-1">
                            <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@receta.ID"
                               class="text-decoration-none text-dark stretched-link">@receta.Titulo</a>
                        </h5>
                    </div>
                </div>
            </div>
        }

    </div>

    @if (ViewBag.HayAnterior == true || ViewBag.HayMas == true)
    {
        <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
            @if (ViewBag.HayAnterior == true)
            {
                <a class="btn btn-outline-secondary"
                   asp-action="MasPopulares"
                   asp-route-lastId="@ViewBag.PrimerId"
                   asp-route-pagina="@(paginaActual - 1)"
                   asp-route-anterior="true">Anterior</a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled">Anterior</span>
            }

            <span>Página @paginaActual</span>

            @if (ViewBag.HayMas == true)
            {
                <a class="btn btn-outline-secondary"
                   asp-action="MasPopulares"
                   asp-route-lastId="@ViewBag.UltimoId"
                   asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled">Siguiente</span>
            }
        </div>
    }

</div>