
@model backend.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container d-flex justify-content-center py-5">
    <div class="card shadow-sm p-4 w-100"
         style="max-width: 500px; border: 1px solid #54494B;">

        <h3 class="text-center mb-4">Mi Perfil</h3>

        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl"
                     alt="Avatar"
                     class="rounded-circle"
                     style="width: 130px; height: 130px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white
                            d-flex align-items-center justify-content-center
                            mx-auto"
                     style="width: 130px; height: 130px; font-size: 45px;">
                    @Model.Nombre.Substring(0, 1).ToUpper()
                </div>
            }
        </div>

        <div class="mb-3">
            <strong>Nombre:</strong>
            <p>@Model.Nombre</p>
        </div>

        <div class="mb-3">
            <strong>Email:</strong>
            <p>@Model.Email</p>
        </div>

        <div class="mb-3">
            <strong>Rol:</strong>
            <p>@Model.rol</p>
        </div>

<div class="d-grid gap-2 mt-4">
        <a asp-controller="Usuarios"
           asp-action="EditarPerfil"
           class="btn boton-marron w-100">
            Editar Perfil
        </a>

        @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Usuarios"
           asp-action="Index"
           class="btn btn-dark">
            Administrar Usuarios
        </a>
    }


    <form asp-controller="Login"
          asp-action="Logout"
          method="post"
          class="w-100">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-outline-danger w-100">
            Cerrar Sesión
        </button>
    </form>
</div>

    </div>
</div>
