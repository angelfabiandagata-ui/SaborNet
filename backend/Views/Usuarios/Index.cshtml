
@model IEnumerable<backend.Models.Usuario>

@using System.Security.Claims

@{
    ViewData["Title"] = "Administrar Usuarios";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;

    string? miId = User.FindFirstValue(
        ClaimTypes.NameIdentifier);
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        Administración de Usuarios
    </h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">

            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var usuario in Model)
                {
                    bool esMiCuenta =
                        miId == usuario.Id.ToString();

                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(usuario.AvatarUrl))
                            {
                                <img src="@usuario.AvatarUrl"
                                     alt="Avatar"
                                     class="rounded-circle"
                                     style="width:45px;height:45px;object-fit:cover;" />
                            }
                        </td>

                        <td>
                            @usuario.Nombre

                            @if (esMiCuenta)
                            {
                                <span class="text-muted small">
                                    (Vos)
                                </span>
                            }
                        </td>

                        <td>
                            @usuario.rol
                        </td>

                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-2 flex-wrap">

                                <!-- VER PERFIL -->
                                <a asp-controller="Usuarios"
                                   asp-action="Perfil"
                                   asp-route-id="@usuario.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Ver
                                </a>

                                <!-- CAMBIAR ROL -->
                                <form asp-controller="Usuarios"
                                      asp-action="CambiarRol"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@usuario.Id" />

                                    @if (usuario.rol ==
                                        backend.Models.Usuario.Rol.Administrador)
                                    {
                                        <input type="hidden"
                                               name="nuevoRol"
                                               value="Usuario" />

                                        <button type="submit"
                                                class="btn btn-sm boton-marron"
                                                disabled="@(!usuario.Activo || esMiCuenta)">
                                            Hacer usuario
                                        </button>
                                    }
                                    else
                                    {
                                        <input type="hidden"
                                               name="nuevoRol"
                                               value="Administrador" />

                                        <button type="submit"
                                                class="btn btn-sm boton-marron"
                                                disabled="@(!usuario.Activo || esMiCuenta)">
                                            Hacer Admin
                                        </button>
                                    }
                                </form>

                                <!-- ALTA / BAJA LÓGICA -->
                                <form asp-controller="Usuarios"
                                      asp-action="CambiarEstado"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@usuario.Id" />

                                    <input type="hidden"
                                           name="activo"
                                           value="@(usuario.Activo ? "false" : "true")" />

                                    @if (usuario.Activo)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@esMiCuenta">
                                            Baja
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                disabled="@esMiCuenta">
                                            Alta
                                        </button>
                                    }
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN -->
    <div class="d-flex justify-content-center gap-2 mt-4">

        @if (paginaActual > 1)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual - 1)"
               class="btn btn-outline-secondary">
                Anterior
            </a>
        }

        <span class="align-self-center">
            Página @paginaActual de @totalPaginas
        </span>

        @if (paginaActual < totalPaginas)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual + 1)"
               class="btn btn-outline-secondary">
                Siguiente
            </a>
        }

    </div>
</div>
