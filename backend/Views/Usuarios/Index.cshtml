
@model IEnumerable<backend.Models.Usuario>

@{
    ViewData["Title"] = "Administrar Usuarios";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        Administración de Usuarios
    </h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(usuario.AvatarUrl))
                            {
                                <img src="@usuario.AvatarUrl"
                                     alt="Avatar"
                                     class="rounded-circle"
                                     style="width: 45px; height: 45px; object-fit: cover;" />
                            }
                        </td>

                        <td>@usuario.Nombre</td>

                        <td>@usuario.rol</td>

                        <td>
                            <a asp-action="Perfil"
                               asp-route-id="@usuario.Id"
                               class="btn btn-sm btn-outline-secondary mb-1">
                                Ver
                            </a>

                            <form asp-action="CambiarRol"
                                  asp-route-id="@usuario.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <select name="nuevoRol"
                                        class="form-select form-select-sm d-inline-block"
                                        style="width: auto;">
                                    @foreach (var rol in Enum.GetValues<backend.Models.Usuario.Rol>())
                                    {
                                        if (rol == usuario.rol)
                                        {
                                            <option value="@rol" selected>@rol</option>
                                        }
                                        else
                                        {
                                            <option value="@rol">@rol</option>
                                        }
                                    }
                                </select>

                                <button type="submit"
                                        class="btn btn-sm boton-marron">
                                    Cambiar Rol
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        int paginaActual = ViewBag.PaginaActual ?? 1;
        int totalPaginas = ViewBag.TotalPaginas ?? 1;
    }

    <div class="d-flex justify-content-center gap-2 mt-4">
        @if (paginaActual > 1)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual - 1)"
               class="btn btn-outline-secondary">
                Anterior
            </a>
        }

        <span class="align-self-center">
            Página @paginaActual de @totalPaginas
        </span>

        @if (paginaActual < totalPaginas)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual + 1)"
               class="btn btn-outline-secondary">
                Siguiente
            </a>
        }
    </div>
</div>
