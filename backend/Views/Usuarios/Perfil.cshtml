@model backend.Models.Usuario

@{
    ViewData["Title"] = "Perfil de Usuario";
}

<div class="container d-flex justify-content-center py-5">
    <div class="card shadow-sm p-4 w-100 text-center"
         style="max-width: 450px; border: 1px solid #54494B;">

        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl"
                 alt="Avatar"
                 class="rounded-circle mx-auto mb-3"
                 style="width: 130px; height: 130px; object-fit: cover;" />
        }

        <h3>@Model.Nombre</h3>

        <p class="text-muted">
            Miembro de SaborNet
        </p>

        <a asp-controller="Recetas"
           asp-action="Index"
           class="btn boton-marron mt-3">
            Ver Recetas
        </a>
    </div>
</div>
