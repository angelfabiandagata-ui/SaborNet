@model backend.Models.RegistroViewModel
@{
    ViewData["Title"] = "Registrarse";
}

<h3>Registrarse</h3>

<form method="post" asp-action="Registrarse">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <label asp-for="Nombre">Nombre de usuario</label>
        <input asp-for="Nombre" placeholder="nombre">
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="Password">Contraseña</label>
        <input asp-for="Password" placeholder="*****">
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="ConfirmarPassword">Repetir contraseña</label>
        <input asp-for="ConfirmarPassword" placeholder="*****">
        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" placeholder="usuario@gmail.com">
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="AvatarUrl">Avatar (opcional)</label>
        <input asp-for="AvatarUrl" placeholder="URL del avatar">
        <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
    </div>

    <button type="submit">Registrarse</button>
</form>