@using backend.Models
@{
    ViewData["Title"] = "SaborNET";

    var populares = ViewBag.Populares as List<Receta> ?? new List<Receta>();
    var nuevas = ViewBag.Nuevas as List<Receta> ?? new List<Receta>();

    var promedios = ViewBag.Promedios
        as Dictionary<int, (double promedio, int total)>
        ?? new Dictionary<int, (double promedio, int total)>();

    var secciones = new[]
    {
        (Titulo: "Recetas más populares", Recetas: populares, Accion: "MasPopulares"),
        (Titulo: "Recetas nuevas", Recetas: nuevas, Accion: "MasRecientes")
    };
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold color-marron">Bienvenido a Sabor<b>Net</b></h1>
        <p class="text-muted">Descubrí, cociná y compartí las mejores recetas de la comunidad</p>
    </div>

    @foreach (var seccion in secciones)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@seccion.Titulo</h2>

            <a asp-controller="Recetas"
               asp-action="@seccion.Accion"
               class="btn boton-marron">
                Ver más
            </a>
        </div>

        <div class="row g-4 mb-5">

            @foreach (var receta in seccion.Recetas)
            {
                var valoracion = promedios.GetValueOrDefault(receta.ID);

                int estrellas = (int)Math.Round(
                    valoracion.promedio,
                    MidpointRounding.AwayFromZero
                );

                <div class="col-md-6 col-lg-3">

                    <div class="card h-100 shadow-sm"
                         style="border: 1px solid #54494B; overflow: hidden;">

                        @if (receta.FotoDatos != null)
                        {
                            <img src="/Imagenes/Receta/@receta.ID"
                                 class="card-img-top"
                                 alt="@receta.Titulo"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else if (!string.IsNullOrEmpty(receta.FotoPrincipal))
                        {
                            <img src="@receta.FotoPrincipal"
                                 class="card-img-top"
                                 alt="@receta.Titulo"
                                 style="height: 200px; object-fit: cover;" />
                        }

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">@receta.Titulo</h5>

                            <div class="mb-3">
                                @if (valoracion.total > 0)
                                {
                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                        <span style="color: #E5A127;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= estrellas)
                                                {
                                                    <i class="fa-solid fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-star"></i>
                                                }
                                            }
                                        </span>
                                        <strong>@valoracion.promedio.ToString("0.0")</strong>
                                        <small class="text-muted">(@valoracion.total)</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="color: #B0B0B0;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fa-regular fa-star"></i>
                                            }
                                        </span>
                                        <small class="text-muted">Sin valoraciones</small>
                                    </div>
                                }
                            </div>

                            <p class="card-text">
                                @(receta.Descripcion.Length > 80
                                    ? receta.Descripcion[..80] + "…"
                                    : receta.Descripcion)
                            </p>

                            <a asp-controller="Recetas"
                               asp-action="Detalle"
                               asp-route-id="@receta.ID"
                               class="btn boton-marron mt-auto">
                                Ver Detalles
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

        @if (!seccion.Recetas.Any())
        {
            <div class="alert alert-info text-center mb-5">
                Todavía no hay recetas para mostrar.
            </div>
        }
    }

</div>