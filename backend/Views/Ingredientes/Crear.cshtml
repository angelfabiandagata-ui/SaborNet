@model backend.Models.Ingrediente

@{
    ViewData["Title"] = "Crear Ingrediente";
}

<div class="container d-flex justify-content-center align-items-center py-5">
    <div class="card shadow-sm p-4 w-100"
         style="max-width: 600px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); border: 1px solid #54494B;">
        <h3>Cargar Nuevo Ingrediente</h3>

        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="nombre" class="form-label">Nombre del Ingrediente</label>
                <input asp-for="nombre" class="form-control" placeholder="Ej. Huevo" required />
                <span asp-validation-for="nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="unidadDeMedida" class="form-label">Unidad de Medida</label>
                <input asp-for="unidadDeMedida" class="form-control" placeholder="Ej. gramos, litros, unidades..."
                       required />
                <span asp-validation-for="unidadDeMedida" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenDeIngrediente" class="form-label">Imagen del Ingrediente</label>
                <input asp-for="ImagenDeIngrediente" class="form-control" type="file" accept="image/*" required />
                <span asp-validation-for="ImagenDeIngrediente" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn boton-marron w-100 mt-2">
                Guardar Ingrediente
            </button>
        </form>

    </div>
</div>