<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SaborNet</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/backend.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-3"
             style="background-color: #54494B;">

            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand fw-medium text-white fs-4"
                   asp-controller="Home"
                   asp-action="Index">
                    Sabor<b>Net.</b>
                </a>

                <!-- MENÚ RESPONSIVE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <!-- ENLACES PRINCIPALES -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Recetas"
                               asp-action="Index">
                                Recetas 
                            </a>
                        </li>



                        @if (User.IsInRole("Administrador"))
                        {
                            <!-- ADMINISTRACIÓN -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Administración
                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Categorias"
                                           asp-action="Index">
                                            Categorías
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Usuarios"
                                           asp-action="Index">
                                            Usuarios
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }

                    </ul>

                    <!-- BUSCADOR -->
                    <form class="d-flex mx-lg-3 my-2 my-lg-0"
                          role="search"
                          asp-controller="Recetas"
                          asp-action="Index"
                          method="get">

                        <div class="input-group">

                            <input type="text"
                                   name="termino"
                                   class="form-control"
                                   placeholder="Buscá una receta"
                                   aria-label="Buscar receta" />

                            <button class="btn btn-light"
                                    type="submit">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                Buscar
                            </button>

                        </div>
                    </form>


<!-- USUARIO -->
<div class="d-flex align-items-center gap-2">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="dropdown">

            <a class="btn btn-outline-light dropdown-toggle text-nowrap"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">

                @User.Identity.Name

            </a>

            <ul class="dropdown-menu dropdown-menu-end">

                <li>
                    <a class="dropdown-item"
                       asp-controller="Usuarios"
                       asp-action="MiPerfil">
                        Mi perfil
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Recetas"
                       asp-action="MisRecetas">
                        Mis recetas
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Recetas"
                       asp-action="Crear">
                        Publicar receta
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Ingredientes"
                       asp-action="Index">
                        Ingredientes
                    </a>
                </li>

            </ul>

        </div>
    }
    else
    {
        <a class="btn btn-outline-light text-nowrap"
           asp-controller="Login"
           asp-action="Login">
            Iniciar Sesión
        </a>
    }

</div>

                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO DE CADA VISTA -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SaborNet -
            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
```