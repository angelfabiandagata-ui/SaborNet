
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SaborNet</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/backend.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-3"
             style="background-color: #54494B;">

            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand fw-medium text-white fs-4"
                   asp-controller="Home"
                   asp-action="Index">
                    Sabor<b>Net</b>
                </a>

                <!-- MENÚ RESPONSIVE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <!-- ENLACES PRINCIPALES -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Recetas"
                               asp-action="MasPopulares">
                                Recetas Populares
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Recetas"
                               asp-action="MasRecientes">
                                Recetas Nuevas
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Recetas"
                                   asp-action="Crear">
                                    Crear Receta
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- BUSCADOR -->
                    <form class="d-flex mx-lg-3 my-2 my-lg-0"
                          role="search"
                          asp-controller="Recetas"
                          asp-action="Index"
                          method="get">

                        <div class="input-group">

                            <input type="text"
                                   name="termino"
                                   class="form-control"
                                   placeholder="Buscá una receta"
                                   aria-label="Buscar receta" />

                            <button class="btn btn-light"
                                    type="submit">
                                Buscar
                            </button>

                        </div>
                    </form>

                    <!-- USUARIO -->
                    <div class="d-flex align-items-center gap-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
    
                            
                            
                            <a class="btn btn-outline-light txt-nowrap"
                               asp-controller="Usuarios"
                               asp-action="MiPerfil">
                                @User.Identity.Name
                            </a>
                        }
                        else
                        {
                            <!-- INICIAR SESIÓN -->
                            <a class="btn btn-outline-light text-nowrap"
                               asp-controller="Login"
                               asp-action="Login">
                                Iniciar Sesión
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO DE CADA VISTA -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SaborNet -
            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
